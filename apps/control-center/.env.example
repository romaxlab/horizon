# Copy to .env.local to override. All values are validated in src/shared/config.

# Data source: mock (in-browser simulator, default) or remote (REST + WebSocket backend).
VITE_DATA_SOURCE=mock
# Required when VITE_DATA_SOURCE=remote; see docs/ARCHITECTURE.md for the endpoints.
# VITE_API_URL=https://api.example.com/v1
# VITE_WS_URL=wss://api.example.com/realtime

# Show simulator demo controls (true/false). Defaults to true in dev, false in production builds.
VITE_DEMO_CONTROLS=true

# Start the prepared Area Scan demo mission on startup (true/false). Defaults to false.
VITE_DEMO_AUTOSTART=false

# Simulator mode: deterministic (same run every time) or random. Defaults to deterministic.
VITE_SIMULATOR_MODE=deterministic

# Cesium ion access token (https://ion.cesium.com/tokens). Optional: enables the 3D map view
# (Google Photorealistic 3D Tiles via ion, falling back to Cesium World Terrain + OSM Buildings).
# Put the real token in .env.local, which is git-ignored. Never commit it.
VITE_CESIUM_ION_TOKEN=

# Telemetry → state flush interval in ms (16–1000). Defaults to 100.
VITE_TELEMETRY_FLUSH_MS=100
